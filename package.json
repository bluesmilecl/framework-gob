{
  "name": "gob-cl-tailwind",
  "version": "4.0.0",
  "description": "Framework CSS del Gobierno de Chile (gob.cl) reconstruido con Tailwind CSS 4: mismos lineamientos gráficos, componentes e iconos, más moderno y ampliado.",
  "license": "MIT",
  "type": "module",
  "style": "dist/gob.css",
  "main": "dist/gob.js",
  "module": "dist/gob.esm.js",
  "files": [
    "dist",
    "src",
    "skills",
    "icons",
    "brand",
    "scripts",
    "tools",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./theme.css": "./src/theme.css",
    "./compat.css": "./src/compat.css",
    "./icons.css": "./src/icons.generated.css",
    "./fonts.css": "./dist/fonts.css",
    "./js": {
      "import": "./dist/gob.esm.js",
      "default": "./dist/gob.js"
    },
    "./dist/*": "./dist/*",
    "./icons/*": "./icons/*",
    "./icons.json": "./dist/icons.json",
    "./next.css": "./src/next.css",
    "./next/js": "./dist/next/bootstrap6.bundle.min.js",
    "./contrast-tokens.css": "./src/contrast-tokens.css",
    "./chat.css": "./src/chat.css",
    "./app.css": "./src/app.css",
    "./react": {
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "sideEffects": [
    "*.css",
    "./dist/gob.js",
    "./dist/gob.min.js",
    "./dist/gob.esm.js",
    "./dist/next/*.js",
    "./src/js/*.js"
  ],
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:css": "tailwindcss -i src/dist-entry.css -o dist/gob.css && tailwindcss -i src/dist-entry.css -o dist/gob.min.css --minify",
    "build:js": "node scripts/build-js.mjs",
    "build": "npm run build:icons && npm run build:fonts && npm run build:js && npm run build:react && npm run build:next && npm run build:css && npm run build:llms",
    "prepublishOnly": "npm run build",
    "build:core": "node tools/build-core.mjs",
    "build:next": "node tools/build-next.mjs && tailwindcss -i src/next.css -o dist/gob-next.css --minify",
    "build:llms": "node scripts/build-llms.mjs",
    "docs:dev": "node scripts/build-llms.mjs && vite --config site/vite.config.js",
    "docs:build": "node scripts/build-llms.mjs && vite build --config site/vite.config.js",
    "docs:preview": "vite preview --config site/vite.config.js",
    "build:react": "node scripts/build-react.mjs"
  },
  "keywords": [
    "gob.cl",
    "gobierno de chile",
    "tailwindcss",
    "tailwind4",
    "css",
    "design-system",
    "framework"
  ],
  "peerDependencies": {
    "react": ">=18",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "jszip": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.1.0",
    "@fontsource/roboto-slab": "^5.1.0",
    "@gobdigital-cl/gob.cl": "^3.0.10",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "bootstrap-next": "npm:bootstrap@^6.0.0-alpha.1",
    "esbuild": "^0.25.0",
    "html-react-parser": "^5.2.17",
    "jszip": "^3.10.2",
    "lucide-static": "^0.468.0",
    "mammoth": "^1.13.0",
    "postcss": "^8.5.33",
    "pug": "^3.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^14.15.0",
    "source-map": "^0.7.4",
    "tailwindcss": "^4.1.0",
    "vite": "^7.3.8"
  }
}
